# Postgres (optional) — product catalog metadata. Capture works from seed data
# + Vercel Blob when this is unset or unreachable. Any Postgres host works
# (Neon, Railway, etc.).
# DATABASE_URL=postgresql://...

# Clerk Auth (Vercel Marketplace — Hobby tier works)
# After installing Clerk on the project: vercel env pull .env.local
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Vercel Blob (private) — product screenshots, avatars, submissions (required for remote capture)
# Create: vercel blob create-store productbench --access private
# Or: Vercel dashboard → Storage → Blob → Private, then:
#   vercel env pull .env.local
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Comma-separated emails that unlock the full (including non-public) catalog.
ADMIN_EMAILS=you@example.com
