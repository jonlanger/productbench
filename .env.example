# Supabase Postgres (Project Settings → Database → Connection string)
# Prefer the Transaction pooler (port 6543) for the Next.js app.
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# For drizzle-kit push/migrate, you may need the direct connection (port 5432)
# if the pooler rejects DDL. Uncomment and use temporarily when pushing schema:
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# Supabase project URL + publishable/anon key
# From Connect → Framework (matches Supabase's current naming).
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT-REF].supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Optional alias — either PUBLISHABLE_KEY or ANON_KEY works in this app:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role — scripts only (capture/storage sync). Never expose to the browser.
# Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Comma-separated emails that unlock the full (including non-public) catalog.
ADMIN_EMAILS=you@example.com
